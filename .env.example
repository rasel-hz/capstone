# Copy this file to .env and fill it in. .env is ignored by git. Never commit a real key.
# This value is read only by the server. Do not rename it with a VITE_ prefix, which would expose it in the browser.
OPENAI_API_KEY=

# Optional. Defaults to gpt-6-luna, OpenAI's most cost-effective listed model.
# OPENAI_MODEL=gpt-6-luna

# Optional, for the Android app only. The server address it calls. See docs/ANDROID.md.
# This is an address, not a secret. Never put a key in a VITE_ setting.
# VITE_API_BASE=https://your-server.example

# Accounts (Supabase Auth). Find both in the Supabase dashboard: Project Settings > API.
# The URL and the anon (publishable) key are public by design: the browser uses them, and Row Level Security
# protects the data. Never put the service_role or secret key here or in any VITE_ setting.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server only, never VITE_. The Postgres connection string (Project Settings > Database). Used to apply
# migrations (npm run db:migrate) and to find an account's email from its username when someone logs in.
DATABASE_URL=
